PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/bugboard
CLIENT_URL=http://localhost:5173

JWT_ACCESS_SECRET=bugboard_jwt_access_secret_key_production_grade_super_secure_hash
JWT_REFRESH_SECRET=bugboard_jwt_refresh_secret_key_production_grade_super_secure_hash
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Optional Cloudinary (Falls back to local disk if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional Google Gemini (Features gracefully degrade if absent)
GEMINI_API_KEY=

# Optional SMTP Email (Falls back to console logger if empty)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@bugboard.dev